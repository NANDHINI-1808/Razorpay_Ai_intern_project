DATABASE_URL=sqlite:///./payshield.db
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins. If unset, defaults to
# http://localhost:5173-5180 and http://127.0.0.1:5173-5180 (covers Vite's
# automatic port drift when the default port is busy). Set this explicitly
# if your frontend runs somewhere outside that range.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Set to true only once a real email provider is wired into auth_service.py
EMAIL_DELIVERY_CONFIGURED=false

# Leave unset unless real Google OAuth credentials are available
GOOGLE_OAUTH_CLIENT_ID=
